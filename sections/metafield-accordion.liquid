{%- comment -%}
  Metafield accordion
  -------------------
  Collapsible content for product pages (ingredients, how to use, FAQs, shipping...).

  Two sources, rendered in this order:
  1. A list of metaobjects on the product (default: product.metafields.custom.accordion_items),
     each with a `title` (single line text) and a `body` (rich text) field.
     One definition, managed per product from the admin, no theme editing needed.
  2. Blocks added in the theme editor. Block fields accept dynamic sources, so a block
     can be connected to any product metafield.

  Empty items are skipped, and the section renders nothing when every item is empty,
  so one template can serve products with and without the content.

  Uses <details name="..."> for "one open at a time" behaviour: no JavaScript.
{%- endcomment -%}

{%- liquid
  assign namespace = section.settings.metafield_namespace | default: 'custom'
  assign key = section.settings.metafield_key | default: 'accordion_items'
  assign metaobject_items = product.metafields[namespace][key].value

  assign group_name = ''
  if section.settings.single_open
    assign group_name = 'accordion-' | append: section.id
  endif

  assign has_content = false
  for item in metaobject_items
    if item.title != blank and item.body != blank
      assign has_content = true
      break
    endif
  endfor
  for block in section.blocks
    if block.settings.heading != blank and block.settings.content != blank
      assign has_content = true
      break
    endif
  endfor
-%}

{%- if has_content -%}
  <div
    class="metafield-accordion page-width"
    style="--ma-padding-top: {{ section.settings.padding_top }}px; --ma-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="metafield-accordion__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- for item in metaobject_items -%}
      {%- if item.title != blank and item.body != blank -%}
        <details
          class="metafield-accordion__item"
          {% if group_name != '' %}
            name="{{ group_name }}"
          {% endif %}
          {% if forloop.first and section.settings.open_first %}
            open
          {% endif %}
        >
          <summary class="metafield-accordion__title">{{ item.title | escape }}</summary>
          <div class="metafield-accordion__body rte">{{ item.body | metafield_tag }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}

    {%- for block in section.blocks -%}
      {%- if block.settings.heading != blank and block.settings.content != blank -%}
        <details
          class="metafield-accordion__item"
          {% if group_name != '' %}
            name="{{ group_name }}"
          {% endif %}
          {% if block.settings.open_by_default %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="metafield-accordion__title">{{ block.settings.heading | escape }}</summary>
          <div class="metafield-accordion__body rte">{{ block.settings.content }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.faq_schema -%}
    {%- capture faq_entries -%}
      {%- for item in metaobject_items -%}
        {%- if item.title != blank and item.body != blank -%}
          {
            "@type": "Question",
            "name": {{ item.title | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.body | metafield_text | json }} }
          },
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.heading != blank and block.settings.content != blank -%}
          {
            "@type": "Question",
            "name": {{ block.settings.heading | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.content | strip_html | json }} }
          },
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign faq_entries = faq_entries | strip | remove_last: ',' -%}
    <script type="application/ld+json">
      { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{{ faq_entries }}] }
    </script>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div class="metafield-accordion page-width">
    <p class="metafield-accordion__empty">
      Metafield accordion: this product has no content yet. Fill the
      <code>{{ namespace }}.{{ key }}</code> metafield or add blocks.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .metafield-accordion {
    padding-top: var(--ma-padding-top);
    padding-bottom: var(--ma-padding-bottom);
  }
  .metafield-accordion__item {
    border-bottom: 1px solid rgba(var(--color-foreground, 0, 0, 0), 0.15);
  }
  .metafield-accordion__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }
  .metafield-accordion__title::-webkit-details-marker {
    display: none;
  }
  .metafield-accordion__title::after {
    content: '';
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-25%) rotate(45deg);
    transition: transform 0.2s ease;
  }
  .metafield-accordion__item[open] > .metafield-accordion__title::after {
    transform: translateY(25%) rotate(-135deg);
  }
  .metafield-accordion__body {
    padding-bottom: 1.2rem;
  }
  .metafield-accordion__empty {
    padding: 2rem;
    border: 1px dashed currentColor;
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: reduce) {
    .metafield-accordion__title::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Metafield accordion",
  "tag": "section",
  "class": "section-metafield-accordion",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Metaobject source"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "accordion_items",
      "info": "List of metaobjects with a 'title' and a 'body' (rich text) field."
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Only one item open at a time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first metaobject item",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "faq_schema",
      "label": "Output FAQPage structured data",
      "default": false,
      "info": "Only for genuine question-and-answer content."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "How to use"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "Connect a product metafield with the dynamic source button."
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Metafield accordion"
    }
  ]
}
{% endschema %}
