{%- comment -%}
  Sticky add to cart
  ------------------
  A bar that appears once the product form's own button has scrolled out of view.

  It does not add to cart itself: the button submits the theme's product form, so the
  theme's own logic still runs (variant, quantity, selling plan, line item properties,
  cart drawer or notification). That keeps it compatible with any Online Store 2.0 theme.

  The bar shows whichever variant is selected in the main form, re-read whenever the
  form changes and whenever the bar is shown.

  Add this section to the product template below the main product section.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign image = current_variant.featured_image | default: product.featured_image
-%}

<sticky-add-to-cart
  class="sticky-atc sticky-atc--{{ section.settings.position }}"
  data-hide-on-desktop="{{ section.settings.hide_on_desktop }}"
  aria-hidden="true"
  inert
>
  <div class="sticky-atc__inner page-width">
    {%- if image and section.settings.show_image -%}
      {{
        image
        | image_url: width: 120
        | image_tag: class: 'sticky-atc__image', width: 60, height: 60, loading: 'lazy', alt: product.title, data-sticky-image: ''
      }}
    {%- endif -%}

    <div class="sticky-atc__text">
      <p class="sticky-atc__title">{{ product.title | escape }}</p>
      <p class="sticky-atc__meta">
        <span data-sticky-variant>
          {%- unless product.has_only_default_variant -%}{{ current_variant.title | escape }}{%- endunless -%}
        </span>
        <span class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>
      </p>
    </div>

    <button
      type="button"
      class="sticky-atc__button button"
      data-sticky-button
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
      {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
    </button>
  </div>

  <script type="application/json" data-sticky-variants>
    {
      {%- for variant in product.variants -%}
        {%- assign variant_image = variant.featured_image | default: product.featured_image -%}
        "{{ variant.id }}": {
          "title": {{ variant.title | json }},
          "price": {{ variant.price | money | json }},
          "available": {{ variant.available | json }},
          "image": {% if variant_image %}{{ variant_image | image_url: width: 120 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
</sticky-add-to-cart>

<script src="{{ 'sticky-add-to-cart.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .sticky-atc {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 30;
    background: rgb(var(--color-background, 255, 255, 255));
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.12);
    transition: transform 0.25s ease;
  }
  .sticky-atc--bottom {
    bottom: 0;
    transform: translateY(110%);
  }
  .sticky-atc--top {
    top: 0;
    transform: translateY(-110%);
  }
  .sticky-atc.is-visible {
    transform: translateY(0);
  }
  .sticky-atc__inner {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }
  .sticky-atc__image {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
  }
  .sticky-atc__text {
    flex: 1;
    min-width: 0;
  }
  .sticky-atc__title,
  .sticky-atc__meta {
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .sticky-atc__title {
    font-weight: 600;
  }
  .sticky-atc__meta {
    display: flex;
    gap: 0.8rem;
    font-size: 0.9em;
    opacity: 0.8;
  }
  .sticky-atc__button {
    flex-shrink: 0;
  }
  .sticky-atc__button.is-loading {
    opacity: 0.6;
    pointer-events: none;
  }
  /* Keep the page's last content (footer) reachable above the bar. */
  body.has-sticky-atc {
    padding-bottom: var(--sticky-atc-height, 0px);
  }
  @media screen and (min-width: 990px) {
    .sticky-atc[data-hide-on-desktop='true'] {
      display: none;
    }
  }
  @media screen and (max-width: 749px) {
    .sticky-atc__image {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-atc {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky add to cart",
  "tag": "section",
  "class": "section-sticky-atc",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "bottom",
      "options": [
        { "value": "bottom", "label": "Bottom of the screen" },
        { "value": "top", "label": "Top of the screen" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Mobile and tablet only",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Sticky add to cart"
    }
  ]
}
{% endschema %}
