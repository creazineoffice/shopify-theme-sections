{%- comment -%}
  Product structured data (JSON-LD)
  ---------------------------------
  Richer than most themes' default output: one Offer per variant with its own SKU, GTIN,
  price and stock, ratings from Shopify's standard review metafields, an optional return
  policy, and a BreadcrumbList when the product is viewed inside a collection.

  Usage, in the product section or template (remove the theme's own Product JSON-LD first,
  so Google does not see two different Product entities):
    {% render 'product-json-ld', product: product %}
    {% render 'product-json-ld', product: product, return_days: 7, return_country: 'IN' %}

  Ratings come from reviews.rating and reviews.rating_count, which review apps such as
  Judge.me and Shopify Product Reviews write to.
{%- endcomment -%}

{%- liquid
  assign brand = product.vendor | default: shop.name
  assign description = product.description | replace: '</', ' </' | replace: '<br', ' <br' | strip_html | strip_newlines | strip | truncate: 5000
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ request.origin | append: product.url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    "description": {{ description | json }},
    "brand": { "@type": "Brand", "name": {{ brand | json }} },
    {%- if product.media.size > 0 %}
    "image": [
      {%- for media in product.media limit: 6 -%}
        {{ media.preview_image | image_url: width: 1920 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    {%- endif %}
    {%- if rating and rating_count > 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ rating.rating | json }},
      "bestRating": {{ rating.scale_max | json }},
      "worstRating": {{ rating.scale_min | json }},
      "ratingCount": {{ rating_count | json }}
    },
    {%- endif %}
    "offers": [
      {%- for variant in product.variants -%}
        {%- liquid
          assign barcode = variant.barcode | remove: ' '
          assign gtin_key = ''
          case barcode.size
            when 8
              assign gtin_key = 'gtin8'
            when 12
              assign gtin_key = 'gtin12'
            when 13
              assign gtin_key = 'gtin13'
            when 14
              assign gtin_key = 'gtin14'
          endcase
        -%}
        {
          "@type": "Offer",
          "url": {{ request.origin | append: variant.url | json }},
          {%- if variant.sku != blank %}
          "sku": {{ variant.sku | json }},
          {%- endif %}
          {%- if gtin_key != '' %}
          "{{ gtin_key }}": {{ barcode | json }},
          {%- endif %}
          {%- unless product.has_only_default_variant %}
          "name": {{ product.title | append: ' - ' | append: variant.title | json }},
          {%- endunless %}
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          {%- if return_days %}
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": {{ return_country | default: localization.country.iso_code | json }},
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": {{ return_days | json }},
            "returnMethod": "https://schema.org/ReturnByMail"
          },
          {%- endif %}
          "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{%- if collection -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      ]
    }
  </script>
{%- endif -%}
